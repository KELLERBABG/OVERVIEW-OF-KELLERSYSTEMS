{
  "name": "@fungal/client",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fungal/core": "workspace:*",
    "@fungal/mycelial-mesh": "workspace:*",
    "@fungal/wasm-executor": "workspace:*",
    "@fungal/task-distribution": "workspace:*",
    "@fungal/resource-scoring": "workspace:*",
    "@fungal/consensus": "workspace:*",
    "@fungal/incentive-token": "workspace:*",
    "@fungal/substrate-layer": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^1.6.0"
  }
}