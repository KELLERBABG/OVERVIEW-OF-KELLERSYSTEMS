[Unit]
Description=Ambient Thermal Arbitrage (ATA) Edge Gateway
After=network.target network-online.target systemd-time-wait-sync.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/ata
ExecStart=/opt/ata/thermal-arbitrage-mvp
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s

# Hardware & Systemd Watchdog Integration:
# ATA pings systemd every 5s; systemd triggers reboot/restart if hung for >15s
WatchdogSec=15s

# Environment Variables (Set Secrets here or via /etc/default/ata-gateway)
EnvironmentFile=-/etc/default/ata-gateway
Environment=RUST_LOG=info
Environment=ATA_CONFIG=/opt/ata/config.toml

# Hardening & Sandboxing for Edge Linux:
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/ata/data_cache /opt/ata/thermal_arbitrage_log.csv /opt/ata/ota_staging
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
