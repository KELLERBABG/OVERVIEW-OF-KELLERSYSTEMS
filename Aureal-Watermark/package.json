{
  "name": "aureal-watermark",
  "version": "0.2.7",
  "description": "Audio watermarking for leak tracing and provenance records",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "bin": {
    "aureal-watermark": "bin/auralwatermark.js",
    "auralwatermark": "bin/auralwatermark.js"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node bin/auralwatermark.js",
    "build:engine": "node scripts/build-engine.js",
    "sync:site": "node scripts/sync-site.js && node scripts/build-engine.js",
    "sync:site:check": "node scripts/sync-site.js --check && node scripts/build-engine.js --check",
    "seo": "node scripts/build_seo.mjs",
    "seo:check": "node scripts/build_seo.mjs --check",
    "bundle": "node scripts/bundle.js"
  },
  "devDependencies": {
    "rcedit": "^4.0.1"
  },
  "keywords": [
    "audio",
    "watermark",
    "provenance",
    "spread-spectrum",
    "dsp",
    "leak-tracking",
    "copyright-protection",
    "audiowatermark"
  ],
  "author": "KELLERBABG",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KELLERBABG/Aureal-Watermark.git"
  },
  "bugs": {
    "url": "https://github.com/KELLERBABG/Aureal-Watermark/issues"
  },
  "homepage": "https://github.com/KELLERBABG/Aureal-Watermark#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/",
    "bin/",
    "site/",
    "assets/",
    "types/",
    "LICENSE.md",
    "README.md"
  ]
}
