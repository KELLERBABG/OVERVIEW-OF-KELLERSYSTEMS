{
  "name": "washtrap-ledger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @washtrap/api dev\" \"pnpm --filter @washtrap/web dev\"",
    "build": "pnpm --filter @washtrap/shared build && pnpm --filter @washtrap/api build && pnpm --filter @washtrap/web build",
    "lint": "eslint packages/*/src",
    "typecheck": "tsc --noEmit -p packages/api/tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "test": "pnpm --filter @washtrap/api test",
    "migrate": "pnpm --filter @washtrap/api migrate",
    "seed": "pnpm --filter @washtrap/api seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  }
}
