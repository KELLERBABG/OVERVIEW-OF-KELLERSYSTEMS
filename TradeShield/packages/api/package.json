{
  "name": "@washtrap/api",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "simulate": "tsx scripts/simulator.ts",
    "simulate:fast": "tsx scripts/simulator.ts --fast 120",
    "simulate:one": "tsx scripts/simulator.ts --device ESP32-BER-001 --cycles 50",
    "batch-generate": "tsx scripts/batch-generate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@hono/zod-validator": "^0.9.0",
    "@washtrap/shared": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "hono": "^4.4.0",
    "nanoid": "^5.0.0",
    "pdfkit": "^0.20.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.16.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
