# Build artifacts and dependencies
node_modules/
dist/
target/
build/
*.log
.env
.DS_Store

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# Temporary data files
live_events.jsonl

# Generated reconstruction output.
# Everything here is produced by running the pipeline. It is not committed: the
# reports that document the measured numbers are regenerated by the commands in
# docs/ACCURACY_MEASURED.md, so a reader can reproduce them rather than trust a
# stored file. Only the note explaining the directory is tracked.
output_reconstruction/*
!output_reconstruction/README.md

# Raw packet captures written by the acquisition chain
*.msc
