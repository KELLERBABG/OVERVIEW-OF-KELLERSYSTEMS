# ==============================================================================
# ClauseLens Enterprise Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0

# Licence issuance happens on the licence server (worker/), never locally.
# Cloudflare Worker secrets: LICENSE_SECRET (HMAC for CL- keys, must match the worker),
# LICENSE_SIGNING_KEY (RSA-2048 PKCS8 base64; the matching public key is in src/licensing.js).

# Central License / Seat Auth Server for Online Seat Validation
# Default: https://license.kellersystems.dev (Cloudflare Worker in worker/)
CLAUSELENS_AUTH_SERVER=https://license.kellersystems.dev

# Payment Webhook Secrets (for automated provisioning via Stripe / Polar)
STRIPE_WEBHOOK_SECRET=
POLAR_WEBHOOK_SECRET=

# Mail delivery of licence keys after a Polar order (Cloudflare Worker, worker/index.js)
RESEND_API_KEY=
LICENSE_FROM_EMAIL=ClauseLens <lizenz@kellersystems.dev>

# Archil persistent disk storage (server-side only, never exposed to the browser)
# API key from https://console.archil.com/api-keys — starts with "key-", NOT a disk/mount token.
# Keys are region-scoped: use a key from the region set in ARCHIL_REGION.
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1
# Disk id ("dsk-…") holding files that must outlive a run; see bin/archil-persist-check.js
ARCHIL_DISK_ID=

# Test Guard (set to 1 ONLY during local testing or CI to bypass seat activation gate)
# CLAUSELENS_TEST_ACCOUNT=0
