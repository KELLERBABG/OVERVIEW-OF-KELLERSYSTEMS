{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clauselens.dev/schemas/v1/config.json",
  "title": "ClauseLensConfig",
  "description": "Configuration specification for customizing thresholds, detector weights, policy profiles, and custom rules.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "profile": {
      "type": "string",
      "enum": ["default", "b2b_saas", "freelance_consulting", "procurement_strict"],
      "default": "default"
    },
    "weights": {
      "type": "object",
      "properties": {
        "niedrig": { "type": "number", "minimum": 0 },
        "mittel": { "type": "number", "minimum": 0 },
        "hoch": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "hoch": { "type": "number", "minimum": 0, "maximum": 100 },
        "mittel": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "activeDetectors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of active rule detector types. If omitted, all rules are active."
    },
    "customRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "title", "patterns", "severity", "why", "suggestion"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "patterns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "severity": {
            "type": "string",
            "enum": ["niedrig", "mittel", "hoch"]
          },
          "why": { "type": "string" },
          "suggestion": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
