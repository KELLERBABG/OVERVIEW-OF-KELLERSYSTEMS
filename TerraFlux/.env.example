# ==============================================================================
# TerraFlux (FieldSense Engine) — Environment Configuration Template
# Copy this file to .env and fill in production or sandbox credentials:
# cp .env.example .env
# ==============================================================================

# Core Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=fieldsense-dev-insecure-secret-key-change-me
DATABASE_URL=sqlite:///fieldsense.db

# Security & CORS
CORS_ORIGINS=["*"]
ENFORCE_WEBHOOK_AUTH=false

# The Things Network (TTN v3) / ChirpStack Webhook Secret
TTN_WEBHOOK_SECRET=your-ttn-preshared-secret-token-here

# Twilio WhatsApp Business API Credentials (Legacy / Alternative)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_ADVISORY_CONTENT_SID=

# Telegram Bot API Credentials (Recommended / Free: create via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_SECRET=your-telegram-secret-token-here

# Agronomy Decision Engine & Background Services
WEATHER_CACHE_TTL_SECONDS=14400
AUTO_SCHEDULER_ENABLED=true
