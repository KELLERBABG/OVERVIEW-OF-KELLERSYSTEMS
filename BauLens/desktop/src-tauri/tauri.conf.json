{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BauLens",
  "version": "../../package.json",
  "identifier": "dev.kellersystems.baulens",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "BauLens Workhorse",
        "label": "main",
        "width": 1600,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "backgroundColor": "#05070C",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.polar.sh",
      "assetProtocol": {
        "enable": false
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../../dist/baulens.cjs": "baulens.cjs"
    },
    "shortDescription": "Deterministische Bauantrags-Vorpruefung",
    "longDescription": "BauLens prueft Bauvorhaben deterministisch gegen 34 DACH-Regelprofile. Vollstaendig lokal, ohne Netzwerkverbindung.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["German", "English"]
      }
    }
  }
}
